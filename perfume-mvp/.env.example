# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=

# Analytics — GA4 measurement ID (G-XXXXXXXXXX). Script only loads when set.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token. Meta tag only renders when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools HTML-tag verification token. Meta tag only renders when set.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Tag Manager container ID (GTM-XXXXXXX). Script only loads when set.
NEXT_PUBLIC_GTM_ID=

# Meta Pixel ID. Script only loads when set.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token. Server-only secret — never expose via NEXT_PUBLIC_*.
META_CONVERSIONS_API_TOKEN=
